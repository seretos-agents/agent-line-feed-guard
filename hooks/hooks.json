{
  "description": "Detects and repairs CRLF line endings in the files Claude Code parses (the project's .claude/ tree, .claude/*.json, CLAUDE.md, AGENTS.md), which the harness silently ignores when they are CRLF.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/line-feed-guard-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/line-feed-guard-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/line-feed-guard-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
